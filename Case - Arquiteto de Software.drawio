        <mxCell id="XvAvXaqi2Q3R6cSdckoI-26" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" value="Tabela TB_LANCAMENTO_OUTBOX - Mantém os eventos da Transactional Outbox para publicação assíncrona no RabbitMQ." vertex="1">
          <mxGeometry height="115" width="500" x="140" y="-275" as="geometry" />
        </mxCell>
        <mxCell id="kMHDx30ZenmKI_txH6_Q-28" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" value="Tabela TB_HISTORICO_LANCAMENTO - Mantém o histórico processado e a idempotência do consumidor.&lt;br&gt;Tipo: &#39;D&#39; - Débito ou &#39;C&#39; - Crédito. CHECK (Tipo IN (&#39;D&#39;, &#39;C&#39;)).&lt;br&gt;Índice por DataLancamento." vertex="1">
          <mxGeometry height="135" width="540" x="1840" y="-1080" as="geometry" />
        </mxCell>
        <mxCell id="kMHDx30ZenmKI_txH6_Q-29" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" value="PROCESSAMENTO DA OUTBOX&lt;br&gt;1. Worker reserva um lote de eventos PENDENTES usando FOR UPDATE SKIP LOCKED.&lt;br&gt;2. Ao reservar: Status = PROCESSANDO e DataUltimaTentativa = agora.&lt;br&gt;3. Publica no RabbitMQ com Publisher Confirm.&lt;br&gt;4. Sucesso: Status = PUBLICADO, DataPublicacao = agora e UltimoErro = null.&lt;br&gt;5. Falha: Tentativas++, DataUltimaTentativa = agora, UltimoErro = mensagem e Status = PENDENTE para nova tentativa.&lt;br&gt;6. Não há descarte definitivo por quantidade fixa de tentativas; o intervalo configurado é usado para elevação de log/alerta.&lt;br&gt;7. Eventos presos em PROCESSANDO retornam para PENDENTE após o timeout configurado." vertex="1">
          <mxGeometry height="314" width="460" x="460" y="-2044" as="geometry" />
        </mxCell>
        <mxCell id="kMHDx30ZenmKI_txH6_Q-30" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" value="PROCESSAMENTO DO CONSUMIDOR&lt;br&gt;1. Consumir e desserializar o evento.&lt;br&gt;2. Inserir TB_HISTORICO_LANCAMENTO de forma idempotente por CorrelationId.&lt;br&gt;3. Se o evento for novo, atualizar/criar TB_SALDO_CONSOLIDADO_DIARIO via UPSERT na mesma transação.&lt;br&gt;4. Confirmar a transação.&lt;br&gt;5. Enviar ACK ao RabbitMQ.&lt;br&gt;6. Em falha transitória, aplicar Retry; ao exceder o limite do consumidor, encaminhar para DLQ." vertex="1">
          <mxGeometry height="205" width="490" x="1170" y="-1395" as="geometry" />
        </mxCell>
        <mxCell id="_qtGwKBY9wmBYtRifc_e-5" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" value="&lt;div&gt;1. Correlacionar o mesmo lançamento ponta a ponta.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 0), rgb(162, 162, 74));&quot;&gt;2. Correlacionar logs, mensagens e chamadas distribuídas&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(102, 102, 0), rgb(162, 162, 74));&quot;&gt;pertencentes ao mesmo fluxo.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="670" y="-1370" as="geometry" />
        </mxCell>
        <mxCell id="_qtGwKBY9wmBYtRifc_e-10" parent="1" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;strokeColor=default;fontSize=16;" value="TB_SALDO_CONSOLIDADO_DIARIO" vertex="1">
          <mxGeometry height="310" width="503" x="1843" y="-795" as="geometry" />
        </mxCell>
        <mxCell id="_qtGwKBY9wmBYtRifc_e-11" parent="_qtGwKBY9wmBYtRifc_e-10" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" value="" vertex="1">
