        <mxCell id="_qtGwKBY9wmBYtRifc_e-43" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" value="Tabela TB_SALDO_CONSOLIDADO_DIARIO - Projeção otimizada para consulta do saldo diário consolidado.&lt;br&gt;DataReferencia possui unicidade para permitir UPSERT seguro." vertex="1">
          <mxGeometry height="135" width="546" x="1840" y="-435" as="geometry" />
        </mxCell>
        <mxCell id="_qtGwKBY9wmBYtRifc_e-44" parent="1" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" value="RESILIÊNCIA DA MENSAGERIA - IMPLEMENTAÇÃO ATUAL&lt;br&gt;&lt;br&gt;OUTBOX: falhas de publicação não descartam o evento. O registro retorna para PENDENTE e será tentado novamente. Publisher Confirm valida a publicação no broker.&lt;br&gt;&lt;br&gt;CONSUMIDOR: falhas transitórias seguem para Retry. Quando o limite de reprocessamentos do consumidor é atingido, a mensagem é encaminhada para Dead Letter Queue (DLQ).&lt;br&gt;&lt;br&gt;A idempotência por CorrelationId protege contra republicações e reprocessamentos duplicados." vertex="1">
          <mxGeometry height="320" width="460" x="1470" y="-2047" as="geometry" />
        </mxCell>
