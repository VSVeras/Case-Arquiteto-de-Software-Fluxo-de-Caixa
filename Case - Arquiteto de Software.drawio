        <mxCell id="_qtGwKBY9wmBYtRifc_e-58" parent="_qtGwKBY9wmBYtRifc_e-55" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" value="" vertex="1">
