{
    "ConnectionStrings": {
        "LivroRazao": ""
    },
    "RabbitMq": {
        "Host": "localhost",
        "Porta": 5672,
        "Usuario": "",
        "Senha": "",
        "VirtualHost": "/",
        "NomeDaConexao": "livro-razao",
